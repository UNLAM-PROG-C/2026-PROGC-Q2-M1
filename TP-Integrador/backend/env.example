# Plantilla de variables de entorno del backend. Copiar a .env (que no se versiona)
# o exportarlas en la terminal. Nunca poner secretos reales acá.

# Vectorización automática de Numba/LLVM. El backend CPU secuencial las fija en 0
# (sin SIMD) si no están definidas; ponerlas en 1 solo para experimentar.
NUMBA_LOOP_VECTORIZE=0
NUMBA_SLP_VECTORIZE=0

# --- Backends GPU ------------------------------------------------------------------
# Las lee app/core/constants.py al importarse (exportarlas antes de arrancar).

# CUDA: fracción de la memoria libre de la GPU que puede ocupar la matriz de
# distancias del matching (se mide después de reservar los demás buffers).
GPU_MEMORY_FRACTION=0.8
# OpenCL: fracción de la memoria global (o de la libre, en AMD) para los buffers
# de un trabajo; además se respeta la reserva individual máxima del dispositivo.
OPENCL_MEMORY_FRACTION=0.6
# OpenCL: usar la GPU cuyo nombre o vendor contenga este texto (por ejemplo
# "NVIDIA" para comparar con CUDA en la misma placa cuando también hay una GPU
# integrada AMD). Vacío: AMD primero y, si no hay, la primera GPU.
OPENCL_DEVICE=
# CUDA en Windows: carpeta de cl.exe para nvcc. Vacío: se busca con vswhere.
CUDA_HOST_COMPILER_DIR=
# CUDA: opciones extra de nvcc (por ejemplo -allow-unsupported-compiler si el
# Visual Studio es más nuevo que el CUDA Toolkit).
CUDA_NVCC_OPTIONS=

# --- Proceso web y worker (app/config.py) --------------------------------------------
# Las lee app/config.py al arrancar (python -m app.main). Vacío = valor por defecto.

# Interfaz y puerto del proceso web. Por defecto solo local: escuchar en otra
# interfaz (por ejemplo 0.0.0.0) expone la aplicación a la red.
MOSAIC_HOST=127.0.0.1
MOSAIC_PORT=8000
# Único origen aceptado por CORS y por el WebSocket: el del servidor de Vite
# (FRONTEND_PORT de frontend/env.example).
MOSAIC_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Carpeta de subidas y resultados. Vacío: <temp del sistema>/fotomosaico.
# Al arrancar y al apagar se vacían sus subcarpetas tiles/, targets/ y jobs/.
MOSAIC_TEMP_DIR=
# Tamaño máximo de una subida y de lo descomprimido de un zip, en MB.
MOSAIC_MAX_UPLOAD_MB=2048
# Cantidad máxima de archivos de un lote (entradas del zip o archivos sueltos).
MOSAIC_MAX_ZIP_ENTRIES=20000
# Píxeles máximos de la imagen final (cols·tile_px × rows·tile_px).
MOSAIC_MAX_OUTPUT_PIXELS=150000000
# Lado mayor de la vista previa que muestra la interfaz.
MOSAIC_PREVIEW_MAX_SIDE=2048
# Cantidad de miniaturas del lote que se pueden pedir.
MOSAIC_TILE_SAMPLE_COUNT=12
# Si la estimación de CPU supera estos segundos, la interfaz pide confirmación.
MOSAIC_CPU_CONFIRM_SECONDS=60
# Procesos del pool de decodificación (0 = uno por núcleo).
MOSAIC_DECODE_PROCESSES=0
# Segundos que se espera al worker al apagar antes de terminarlo a la fuerza.
MOSAIC_SHUTDOWN_TIMEOUT_S=15
