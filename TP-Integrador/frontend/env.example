# URL del backend (proceso web FastAPI). Debe coincidir con MOSAIC_HOST y
# MOSAIC_PORT de backend/env.example.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Puerto del servidor de Vite. El origen resultante (http://127.0.0.1:5173)
# tiene que coincidir con MOSAIC_FRONTEND_ORIGIN del backend.
FRONTEND_PORT=5173
